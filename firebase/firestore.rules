rules_version = '2';

// BOOTSTRAP: estas regras exigem que já exista pelo menos um super_admin.
// Para o primeiro acesso, crie manualmente pelo Console do Firebase o documento
//   admin_users/{uid-do-usuario}  =>  { role: "super_admin", active: true, email, displayName, createdAt }
// usando o UID gerado em Authentication. A partir daí o provisionamento é feito
// pela aba Usuários do painel.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper para verificar se o usuário é um administrador autenticado e ativo
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true;
    }

    // Helper para verificar se o usuário é super administrador
    function isSuperAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role == 'super_admin' &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.active == true;
    }

    // Campos que só um super admin pode gravar — evitam autopromoção
    function touchesPrivilegedFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny(['role', 'active', 'uid', 'createdAt', 'createdBy']);
    }

    // 1. Coleção de Administradores
    match /admin_users/{uid} {
      // Qualquer autenticado lê o próprio perfil (o painel precisa disso no boot);
      // admins ativos leem e listam a equipe inteira.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, get: if isAdmin();

      // Perfis são PROVISIONADOS por um super admin. Um usuário autenticado não
      // pode criar o próprio perfil — isso permitiria se autonomear super_admin.
      allow create: if isSuperAdmin();

      // Cada um edita os próprios dados de exibição; papel, status ativo e
      // metadados de criação continuam exclusivos do super admin.
      allow update: if isSuperAdmin()
        || (isAdmin() && request.auth.uid == uid && !touchesPrivilegedFields());

      allow delete: if isSuperAdmin();
    }

    // 2. Coleção de Leads (Cadastros de Clientes)
    match /leads/{leadId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 3. Coleção de Drivers (Motoristas / Cadastros da Frota Legada)
    match /drivers/{driverId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // 4. Coleção de Veículos e Precificação
    match /vehicles/{vehicleId} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    
    match /vehicle_pricing/{pricingId} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // 5. Configurações da Landing e Banners (Hero Slides)
    match /landing/{docId} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /hero_slides/{slideId} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    // 6. Permissões de Roles Dinâmicas
    match /role_permissions/{docId} {
      allow read: if true; 
      allow write: if isSuperAdmin(); 
    }

    // 7. Coleção de Simulador
    match /simulator_scenarios/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Coleção de Depoimentos / Testimonials
    match /testimonials/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // 9. Coleção de Agenda / Appointments
    match /appointments/{docId} {
      allow create, read, write: if isAdmin();
    }

    // 10. Configurações gerais (landing, stats, etc)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 11. Coleção de Diferenciais Operacionais
    match /operational_features/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
